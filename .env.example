# ==============================================================================
# DesignRadar Environment Variables
# Copy this file to .env and populate with your credentials.
# NEVER commit your real .env file to Git.
# ==============================================================================

# Supabase PostgreSQL Database (Required)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API (Required for AI classification)
# Lightweight model: classification is one short post in, twelve fields out.
GEMINI_API_KEY=your-gemini-api-key
# Optional. Defaults to gemini-3.5-flash-lite when unset.
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini transport tuning. Every value below is optional; these are the
# defaults used when the variable is absent. Free tiers should stay at 1.
#
# GEMINI_CONCURRENCY           Requests in flight at once (default 1).
#                               A retry never runs alongside another request.
# GEMINI_MAX_RETRIES           Retries after the first attempt (default 2),
#                               applied to 429/503/timeouts only. 401, 403,
#                               404 and an exhausted quota are never retried.
# GEMINI_INITIAL_RETRY_DELAY_MS  First backoff wait (default 2000). Waits grow
#                               exponentially and carry jitter.
# GEMINI_REQUEST_TIMEOUT_MS    Per-attempt timeout (default 30000).
GEMINI_CONCURRENCY=1
GEMINI_MAX_RETRIES=2
GEMINI_INITIAL_RETRY_DELAY_MS=2000
GEMINI_REQUEST_TIMEOUT_MS=30000

# Search Provider (Required)
# Supported options: 'serper', 'brave'
SEARCH_PROVIDER=serper
SEARCH_API_KEY=your-search-api-key

# Notification Provider (Phase 10)
# Supported options: 'email', 'ntfy', 'mock'
# 'email' delivers the digest through Resend (production default).
# 'ntfy' delivers to a private ntfy topic (legacy).
# 'mock' prints the digest locally and sends nothing — useful for local
# development, and the fallback when NOTIFICATION_PROVIDER is unset.
NOTIFICATION_PROVIDER=email

# After a successful mock send, record the notification and mark the posts as
# sent. Off by default: a printed digest is not a delivery, and marking posts on
# a preview would silently drop them from the next real digest.
NOTIFICATION_MARK_MOCK_SENT=false

# Email via Resend (Required when NOTIFICATION_PROVIDER=email)
# Sign up at https://resend.com, verify your sender domain, and create an API key.
# Set these through `supabase secrets set` for Edge Function production delivery.
RESEND_API_KEY=<set-in-supabase-secrets>
DESIGN_RADAR_EMAIL_TO=<recipient-email>
DESIGN_RADAR_EMAIL_FROM=<verified-sender-address>
# Optional: override the email subject line.
# DESIGN_RADAR_EMAIL_SUBJECT=DesignRadar — Daily Digest
# Optional: per-request timeout in milliseconds. Defaults to 15000.
# NOTIFICATION_TIMEOUT_MS=15000

# Verify delivery end to end before trusting a run:  npm run notify:test

# ntfy (Legacy — only needed when NOTIFICATION_PROVIDER=ntfy)
# Plain HTTP API: POST <NTFY_BASE_URL>/<NTFY_TOPIC> with the digest as the body.
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
# Optional. Only needed for a reserved topic or a self-hosted server that
# requires auth. Leave empty for a normal ntfy.sh topic. Never logged, never
# stored in the database.
NTFY_TOKEN=
# Optional presentation hints.
# NTFY_TITLE=DesignRadar — Daily Digest
# NTFY_PRIORITY=default
# NTFY_TAGS=briefcase,mag

# Application Configuration
TIMEZONE=Africa/Lagos
# NOTE: there is deliberately no DAILY_DIGEST_HOUR. Earlier versions of this file
# listed one, but nothing ever read it — the schedule is set by the Postgres cron
# job in supabase/migrations/005_phase9_scheduling.sql, which runs the daily
# digest at 07:00 UTC = 08:00 Africa/Lagos. Changing an environment variable here
# would not move the digest.
# How far back the digest looks for qualified posts, in hours. 168 = one week,
# so a post found on an unlucky day is still reported instead of being lost.
# The separate 24h window that earns a post the "Verified" heading is fixed in
# src/notifications/digest.js.
DIGEST_LOOKBACK_HOURS=168
# High-priority threshold, not a qualification gate. A post only has to pass the
# eligibility gate in src/ai/score.js (is_recruiting_post && is_product_design_role)
# to be stored and delivered; this value decides whether it is labelled "high" or
# "standard" priority. Lowering it promotes weak matches in the digest, it does
# not admit new posts, and no score is ever adjusted to reach it.
MIN_RELEVANCE_SCORE=60
# NOTE: the recency validity window is fixed at 168h (one week) in
# src/filtering/status.js and is intentionally not configurable. Posts older
# than the window are stored as stale and never appear in a digest.

# ==============================================================================
# Supabase Edge Function (Phase 9 + Phase 10)
# ==============================================================================
# The scheduled Edge Function reads the SAME variable names as above, but from
# the Supabase Edge environment rather than from this file. `.env` is not
# deployed with the function, so a variable set only here is unset in production.
#
# Set each one through the Supabase CLI, substituting real values. Never commit
# the values themselves, and never place them in supabase/functions/:
#
#   supabase secrets set \
#     SUPABASE_URL=... \
#     SUPABASE_SERVICE_ROLE_KEY=... \
#     SEARCH_PROVIDER=serper \
#     SEARCH_API_KEY=... \
#     GEMINI_API_KEY=... \
#     GEMINI_MODEL=... \
#     NOTIFICATION_PROVIDER=email \
#     RESEND_API_KEY=... \
#     DESIGN_RADAR_EMAIL_TO=... \
#     DESIGN_RADAR_EMAIL_FROM=...
#
# Discovery mode needs everything except the email variables. Digest mode needs
# Supabase and Resend, and never uses the search or Gemini keys.
#
# The cron jobs additionally need the service-role key and project URL available
# to Postgres, which is a separate one-time step documented at the top of
# supabase/migrations/005_phase9_scheduling.sql.
#
# Schedules (unchanged from Phase 9):
#   Discovery: every 4 hours  (0 */4 * * *)
#   Digest:    daily at 07:00 UTC = 08:00 Africa/Lagos  (0 7 * * *)
#
# Resend sending limits depend on your plan. The free tier allows 3,000 emails/month
# and 100 emails/day. DesignRadar sends at most one digest per day.
